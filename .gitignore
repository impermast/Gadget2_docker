nbody/ics/*/ic_gate.json
nbody/ics/*/ic_gate_report.txt
nbody/ics/*/ic_profiles.csv

# Generated IC data (HDF5)
*.hdf5
*.h5

# Simulation data
*.dat
nbody/runs/**
**/restartfiles

# Generated plots
testGraphs/*.png
testGraphs/*.pdf
testGraphs/*.gif
