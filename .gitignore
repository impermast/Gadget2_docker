gadget_test/graph/*
gadget_test/snaps/*
test_graph_*
*.png
*.jpeg
*.jpg
*.gif
*.pdf

# Analysis artifacts (nbody/analysis/<block>/...) — трекается только каталог
# графиков REGISTRY.md, сгенерированный runners/registry_docs.py.
nbody/analysis/**
!nbody/analysis/REGISTRY.md
# Curated presentation inputs are source assets, not disposable analysis output.
!nbody/analysis/presentations/
!nbody/analysis/presentations/**
# Presentation exports — keep source scripts/prompts, ignore generated bundles
nbody/analysis/presentations/**/*.pptx
nbody/analysis/presentations/**/gif/preview/
nbody/analysis/presentations/2026-09-10/dsidm_progress_report_html_v6_fixed.html

# Legacy analysis output; retained files remain readable/tracked, new artifacts do not.
nbody/analyse/**

# Legacy output location is gone; presentation source now lives in analysis/presentations.

# Python caches
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/

#tg bot
telegram.conf
.tgbot_state.json
*.log

# LLM infrastructure
# NOTE (git policy): llm/ is TRACKED on the agent/dev branch so that the bot's
# working process is version-controlled. It must NOT be tracked on master.
# After merging agent/dev into master, untrack it again per the documented
# merge procedure in llm/rules/02-workflow.md.
skills/

# Misc
GEMINI.md
.clineignore
.clinerules/
