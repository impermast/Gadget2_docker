# GalIC generated output (keep param files, ignore generated dirs)
nbody/GalIC/halo_nfw_ics/
nbody/ics/*/galic_*/

# IC gate artifacts (profiles/reports are generated by the analysis runner)
nbody/ics/*/ic_gate/
